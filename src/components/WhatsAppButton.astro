---
// Pulsante WhatsApp fisso in basso a destra, presente in tutte le pagine.
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
---

<a
  href={whatsappLink('Ciao! Vorrei informazioni sul tennistavolo.')}
  class="fixed right-4 bottom-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-neon text-navy-950 shadow-lg shadow-black/40 transition-transform hover:scale-105 sm:right-6 sm:bottom-6"
  rel="noopener"
>
  <Icon name="whatsapp" class="h-7 w-7" />
  <span class="sr-only">Scrivici su WhatsApp</span>
</a>
