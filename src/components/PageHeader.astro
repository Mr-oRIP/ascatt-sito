---
// Testata delle pagine interne: scritta piccola, titolo e introduzione.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="border-b border-navy-700 bg-navy-900">
  <div class="page-container py-12 sm:py-16">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 text-4xl sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl text-lg text-mist">{intro}</p>}
    <slot />
  </div>
</div>
