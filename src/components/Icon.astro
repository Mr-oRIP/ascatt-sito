  },
  mail: {
    body: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  },
  instagram: {
    body: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>',
  },
  facebook: {
    body: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  'map-pin': {
    body: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  },
  clock: { body: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' },
  calendar: {
    body: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  },
  'arrow-right': { body: '<path d="M5 12h14M12 5l7 7-7 7"/>' },
  'arrow-left': { body: '<path d="M19 12H5M12 19l-7-7 7-7"/>' },
  external: {
    body: '<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  },
  check: { body: '<path d="M20 6 9 17l-5-5"/>' },
  menu: { body: '<path d="M4 6h16M4 12h16M4 18h16"/>' },
  close: { body: '<path d="M18 6 6 18M6 6l12 12"/>' },
};

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const icon: { body: string; filled?: boolean } = icons[name];
---

<svg
  class:list={['shrink-0', className]}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icon.body}
/>
