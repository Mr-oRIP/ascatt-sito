---
// News: elenco di tutti gli articoli, dal più recente.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SampleNotice from '../../components/SampleNotice.astro';
import NewsCard from '../../components/NewsCard.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="News" description="Notizie, risultati e avvisi dell'ASD ASCA TT: campionati, tornei, corsi ed eventi.">
  <PageHeader eyebrow="News" title="Notizie dalla palestra" intro="Risultati, tornei, eventi e avvisi della società." />

  <section class="section">
    <div class="page-container">
      <div class="max-w-2xl">
        <SampleNotice>Questi articoli sono esempi da sostituire.</SampleNotice>
      </div>
      <h2 class="sr-only">Tutti gli articoli</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <li><NewsCard post={post} /></li>)}
      </ul>
    </div>
  </section>
</Base>
