---
// Pagina non trovata.
import Base from '../layouts/Base.astro';
---

<Base title="Pagina non trovata" noindex>
  <section class="section">
    <div class="page-container py-10 text-center">
      <p class="text-7xl font-extrabold text-neon sm:text-8xl">404</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Palla fuori!</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-mist">La pagina che cerchi non esiste o è stata spostata.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">Torna alla home</a>
        <a href="/news/" class="btn btn-secondary">Leggi le news</a>
      </div>
    </div>
  </section>
</Base>
